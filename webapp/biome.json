{
	"files": {
		"ignore": [
			"node_modules/**",
			"dist/**",
			"test-results/**",
			"playwright-report/**",
			"*.tsbuildinfo"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useImportType": "off",
				"useNumberNamespace": "off",
				"useSelfClosingElements": "off",
				"noUnusedTemplateLiteral": "off"
			},
			"a11y": {
				"noSvgWithoutTitle": "off",
				"useSemanticElements": "off",
				"useButtonType": "off"
			}
		}
	},
	"formatter": {
		"enabled": true
	}
}
