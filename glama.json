{
  "$schema": "https://glama.ai/schemas/mcp.json",
  "name": "vla-mcp",
  "version": "0.1.0",
  "description": "FastMCP 3.2 VLA bridge: X Square Wall-OSS-0.5, WALL-WM on Wan, DMuon co-training, worldlabs/robotics/avatar fleet loops.",
  "author": "Sandra Schipal",
  "license": "MIT",
  "language": "python",
  "framework": "fastmcp",
  "type": "mcp_server",
  "status": "alpha",
  "transport": ["stdio", "http"],
  "keywords": ["vla", "robotics", "world-model", "wall-oss", "mcp", "spatial-ai"],
  "homepage": "https://github.com/sandraschi/vla-mcp",
  "repository": {
    "url": "https://github.com/sandraschi/vla-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "github",
      "identifier": "sandraschi/vla-mcp",
      "transport": {
        "type": "stdio",
        "command": "uv",
        "args": ["run", "python", "-m", "vla_mcp.server", "--stdio"]
      }
    }
  ]
}
