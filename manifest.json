{
  "manifest_version": "0.2",
  "name": "vla-mcp",
  "version": "0.1.0",
  "description": "Vision-Language-Action MCP bridge: Wall-OSS-0.5, WALL-WM, DMuon, fleet simulation data loops",
  "author": {
    "name": "Sandra Schipal",
    "email": "sandra@sandraschi.dev"
  },
  "repository": "https://github.com/sandraschi/vla-mcp",
  "server": {
    "type": "python",
    "entry_point": "src/vla_mcp/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "--project", "${__dirname}", "python", "-m", "vla_mcp.server", "--stdio"],
      "env": {
        "PYTHONPATH": "${__dirname}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "env": [
    {
      "name": "VLA_WALL_X_ROOT",
      "description": "Clone of github.com/X-Square-Robot/wall-x",
      "required": false
    },
    {
      "name": "VLA_DATASET_ROOT",
      "description": "Local episode and export directory",
      "required": false
    }
  ],
  "tools": [
    { "name": "vla_status", "description": "VLA stack status snapshot" },
    { "name": "vla_wall", "description": "Wall-OSS-0.5 VLA operations" },
    { "name": "vla_world_model", "description": "WALL-WM world action model operations" },
    { "name": "vla_dataset", "description": "Event-grounded trajectory registry" },
    { "name": "vla_training", "description": "DMuon co-training prep" },
    { "name": "vla_fleet", "description": "Fleet simulation peer orchestration" },
    { "name": "vla_agentic_workflow", "description": "Multi-step VLA session planning" }
  ]
}
