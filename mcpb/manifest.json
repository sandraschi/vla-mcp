{
  "manifest_version": "0.2",
  "name": "vla-mcp",
  "version": "0.3.1b1",
  "description": "FastMCP 3.2 bridge for Vision-Language-Action: Wall-OSS-0.5, WALL-WM, DMuon co-training, and fleet simulation loops",
  "author": { "name": "Sandra Schipal" },
  "server": {
    "type": "python",
    "entry_point": "src/vla_mcp/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "--directory", "${__dirname}", "python", "-m", "vla_mcp"],
      "env": {
        "PYTHONPATH": "${__dirname}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "vla_status", "description": "VLA stack status" },
    { "name": "vla_pipeline_liveness", "description": "Stale VLA loops + unreachable fleet peers" },
    { "name": "vla_weights", "description": "Hugging Face checkpoint download" },
    { "name": "vla_wall", "description": "Wall-OSS-0.5 VLA" },
    { "name": "vla_xvla", "description": "X-VLA 0.9B PEFT edge adapter" },
    { "name": "vla_world_model", "description": "WALL-WM world model" },
    { "name": "vla_dataset", "description": "Event-joint dataset + numpy export" },
    { "name": "vla_events", "description": "Telemetry event segmentation" },
    { "name": "vla_training", "description": "DMuon co-train launch" },
    { "name": "vla_pipeline", "description": "E2E fleet, ingest, export, DMuon dry_run" },
    { "name": "vla_fleet", "description": "Fleet peer bridge" },
    { "name": "vla_world", "description": "3D room generation via worldlabs-mcp" },
    { "name": "vla_diary", "description": "Personal/dev/news notebooks" },
    { "name": "vla_agentic_workflow", "description": "Multi-step VLA planning" },
    { "name": "vla_help", "description": "Fleet integration, API keys, tools, troubleshooting" },
    { "name": "vla_shutdown", "description": "Orderly self-termination" },
    { "name": "show_vla_status_card", "description": "Show VLA stack status card" },
    { "name": "show_pipeline_run_card", "description": "Show pipeline run card" }
  ]
}
